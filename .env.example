# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Admin credentials (choose one):
# Option A – set plain password (hashed at first run):
CCTV_ADMIN_PASSWORD=change_me_before_running

# Option B – set a pre-hashed bcrypt password (cost 12):
# CCTV_ADMIN_PASSWORD_HASH=$2y$12$...

# JWT signing secret (generate with: openssl rand -hex 32)
CCTV_JWT_SECRET=replace_with_openssl_rand_hex_32

# Per-camera RTSP URLs via environment variable references.
# In the admin panel, set "RTSP URL Env" to the variable name (e.g. CAMERA_LOBBY_RTSP)
# and define it here so credentials never appear in the database.
# CAMERA_LOBBY_RTSP=rtsp://user:password@192.168.1.10:554/stream1
# CAMERA_GARAGE_RTSP=rtsp://user:password@192.168.1.11:554/stream1
